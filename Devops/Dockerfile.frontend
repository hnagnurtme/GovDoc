# Stage 1: Build stage (runs natively on the host's platform to speed up build)
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder

WORKDIR /app

# Copy package lists
COPY Frontend/package.json Frontend/package-lock.json ./

# Install packages using cache mount to speed up npm downloads
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# Copy source code and build
COPY Frontend ./
RUN npm run build

# Stage 2: Runtime stage (runs on target platform)
FROM nginx:1.27-alpine

COPY Devops/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

